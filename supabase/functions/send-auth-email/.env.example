# Server secrets ONLY. Fill in the deployed Supabase dashboard, never Flutter.
BREVO_API_KEY=
SEND_EMAIL_HOOK_SECRET=
BREVO_SENDER_EMAIL="developer.fluxtonx@gmail.com"
BREVO_SENDER_NAME="E-Health"
EHEALTH_SUPPORT_EMAIL=
# Must match Supabase Auth settings; this does not set Auth's enforcement.
AUTH_EMAIL_OTP_EXPIRY_SECONDS=3600
AUTH_EMAIL_OTP_LENGTH=6
# SUPABASE_URL is injected automatically in hosted Edge Functions.
# Match AUTH_RECOVERY_MODE in Flutter: otp (default) or link for legacy templates.
AUTH_RECOVERY_MODE=otp
